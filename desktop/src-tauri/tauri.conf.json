{
  "productName": "Coderix",
  "version": "0.1.0",
  "identifier": "com.coderix.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd /home/wbin/proj/Coder/coderix/desktop && /home/wbin/proj/Coder/coderix/desktop/node_modules/.bin/vite",
    "beforeBuildCommand": "cd /home/wbin/proj/Coder/coderix/desktop && /home/wbin/proj/Coder/coderix/desktop/node_modules/.bin/vite build"
  },
  "app": {
    "windows": [{
      "title": "Coderix",
      "width": 1200,
      "height": 800,
      "minWidth": 800,
      "minHeight": 600,
      "center": true,
      "decorations": true,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ws://127.0.0.1:* http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"]
  }
}
